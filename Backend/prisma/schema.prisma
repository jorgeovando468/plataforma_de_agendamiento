generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}



model appointment_services {
  id             Int          @id @default(autoincrement())
  appointment_id BigInt
  service_id     Int
  price          Decimal      @db.Decimal(12, 2)
  created_at     DateTime     @default(now()) @db.Timestamp(0)
  appointments   appointments @relation(fields: [appointment_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "appointment_services_ibfk_1")
  services       services     @relation(fields: [service_id], references: [id], onUpdate: Restrict, map: "appointment_services_ibfk_2")

  @@index([appointment_id], map: "appointment_id")
  @@index([service_id], map: "service_id")
}

model appointments {
  id                                     BigInt                 @id @default(autoincrement())
  patient_id                             Int
  doctor_id                              Int?
  created_by                             Int?
  start_datetime                         DateTime               @db.DateTime(0)
  end_datetime                           DateTime               @db.DateTime(0)
  status                                 String                 @default("pending") @db.VarChar(50)
  total_price                            Decimal                @default(0.00) @db.Decimal(12, 2)
  currency                               String?                @default("USD") @db.VarChar(5)
  reason                                 String?                @db.VarChar(255)
  notes                                  String?                @db.Text
  created_at                             DateTime               @default(now()) @db.Timestamp(0)
  updated_at                             DateTime?              @db.Timestamp(0)
  cancelled_at                           DateTime?              @db.Timestamp(0)
  cancelled_by                           Int?
  source                                 String?                @default("secretaria") @db.VarChar(50)
  appointment_services                   appointment_services[]
  patients                               patients               @relation(fields: [patient_id], references: [id], onUpdate: Restrict, map: "appointments_ibfk_1")
  doctors                                doctors?               @relation(fields: [doctor_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "appointments_ibfk_2")
  users_appointments_created_byTousers   users?                 @relation("appointments_created_byTousers", fields: [created_by], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "appointments_ibfk_3")
  users_appointments_cancelled_byTousers users?                 @relation("appointments_cancelled_byTousers", fields: [cancelled_by], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "appointments_ibfk_4")
  notifications                          notifications[]
  payments                               payments[]

  @@unique([doctor_id, start_datetime, end_datetime], map: "ux_appointment_unique")
  @@index([cancelled_by], map: "cancelled_by")
  @@index([created_by], map: "created_by")
  @@index([patient_id], map: "patient_id")
}

model audit_logs {
  id           BigInt   @id @default(autoincrement())
  user_id      Int?
  action       String?  @db.VarChar(100)
  target_table String?  @db.VarChar(100)
  target_id    String?  @db.VarChar(100)
  payload      String?  @db.LongText
  created_at   DateTime @default(now()) @db.Timestamp(0)
  users        users?   @relation(fields: [user_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "audit_logs_ibfk_1")

  @@index([user_id], map: "user_id")
}

model blocked_slots {
  id             BigInt   @id @default(autoincrement())
  doctor_id      Int?
  start_datetime DateTime @db.DateTime(0)
  end_datetime   DateTime @db.DateTime(0)
  reason         String?  @db.VarChar(255)
  created_by     Int?
  created_at     DateTime @default(now()) @db.Timestamp(0)
  doctors        doctors? @relation(fields: [doctor_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "blocked_slots_ibfk_1")
  users          users?   @relation(fields: [created_by], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "blocked_slots_ibfk_2")

  @@index([created_by], map: "created_by")
  @@index([doctor_id], map: "doctor_id")
  @@index([start_datetime, end_datetime], map: "idx_blocked_slots_dt")
}

model clinic_hours {
  id         Int      @id @default(autoincrement())
  doctor_id  Int?
  weekday    Int      @db.TinyInt
  start_time DateTime @db.Time(0)
  end_time   DateTime @db.Time(0)
  created_at DateTime @default(now()) @db.Timestamp(0)
  doctors    doctors? @relation(fields: [doctor_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "clinic_hours_ibfk_1")

  @@index([doctor_id], map: "doctor_id")
}

model doctors {
  id             Int             @id @default(autoincrement())
  user_id        Int?
  specialty      String?         @db.VarChar(150)
  license_number String?         @db.VarChar(100)
  active         Boolean?        @default(true)
  created_at     DateTime        @default(now()) @db.Timestamp(0)
  appointments   appointments[]
  blocked_slots  blocked_slots[]
  clinic_hours   clinic_hours[]
  users          users?          @relation(fields: [user_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "doctors_ibfk_1")

  @@index([user_id], map: "user_id")
}

model notifications {
  id             BigInt        @id @default(autoincrement())
  appointment_id BigInt?
  patient_id     Int?
  channel        String?       @db.VarChar(50)
  provider_ref   String?       @db.VarChar(200)
  status         String?       @db.VarChar(50)
  payload        String?       @db.LongText
  created_at     DateTime      @default(now()) @db.Timestamp(0)
  appointments   appointments? @relation(fields: [appointment_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "notifications_ibfk_1")
  patients       patients?     @relation(fields: [patient_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "notifications_ibfk_2")

  @@index([appointment_id], map: "appointment_id")
  @@index([patient_id], map: "patient_id")
}

model patients {
  id            Int             @id @default(autoincrement())
  user_id       Int?
  first_name    String          @db.VarChar(100)
  last_name     String          @db.VarChar(100)
  email         String?         @db.VarChar(150)
  phone         String?         @db.VarChar(30)
  dob           DateTime?       @db.Date
  gender        String?         @db.VarChar(20)
  created_at    DateTime        @default(now()) @db.Timestamp(0)
  updated_at    DateTime?       @db.Timestamp(0)
  deleted_at    DateTime?       @db.Timestamp(0)
  appointments  appointments[]
  notifications notifications[]
  users         users?          @relation(fields: [user_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "patients_ibfk_1")
  payments      payments[]

  @@index([user_id], map: "user_id")
}

model payments {
  id             BigInt        @id @default(autoincrement())
  appointment_id BigInt?
  patient_id     Int?
  amount         Decimal       @db.Decimal(12, 2)
  currency       String?       @default("USD") @db.VarChar(5)
  payment_method String?       @db.VarChar(50)
  status         String?       @default("pending") @db.VarChar(50)
  reference      String?       @db.VarChar(200)
  created_at     DateTime      @default(now()) @db.Timestamp(0)
  appointments   appointments? @relation(fields: [appointment_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "payments_ibfk_1")
  patients       patients?     @relation(fields: [patient_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "payments_ibfk_2")

  @@index([appointment_id], map: "appointment_id")
  @@index([created_at], map: "idx_payments_date")
  @@index([patient_id], map: "patient_id")
}

model roles {
  id          Int      @id @default(autoincrement())
  name        String   @unique(map: "name") @db.VarChar(50)
  description String?  @db.VarChar(255)
  created_at  DateTime @default(now()) @db.Timestamp(0)
  users       users[]
}

model service_prices {
  id         Int       @id @default(autoincrement())
  service_id Int
  price      Decimal   @db.Decimal(12, 2)
  currency   String?   @default("USD") @db.VarChar(5)
  valid_from DateTime  @db.DateTime(0)
  valid_to   DateTime? @db.DateTime(0)
  created_at DateTime  @default(now()) @db.Timestamp(0)
  services   services  @relation(fields: [service_id], references: [id], onUpdate: Restrict, map: "service_prices_ibfk_1")

  @@index([service_id, valid_from, valid_to], map: "idx_service_price_valid")
}

model services {
  id                       Int                    @id @default(autoincrement())
  code                     String?                @unique(map: "code") @db.VarChar(50)
  name                     String                 @db.VarChar(150)
  description              String?                @db.Text
  default_duration_minutes Int                    @default(30)
  created_at               DateTime               @default(now()) @db.Timestamp(0)
  appointment_services     appointment_services[]
  service_prices           service_prices[]
}

model settings {
  id         Int      @id @default(autoincrement())
  key_name   String?  @unique(map: "key_name") @db.VarChar(150)
  value      String?  @db.Text
  updated_at DateTime @default(now()) @db.Timestamp(0)
}

model users {
  id                                            Int             @id @default(autoincrement())
  role_id                                       Int
  first_name                                    String          @db.VarChar(100)
  last_name                                     String          @db.VarChar(100)
  email                                         String?         @unique(map: "email") @db.VarChar(150)
  phone                                         String?         @db.VarChar(30)
  password_hash                                 String?         @db.VarChar(255)
  is_active                                     Boolean?        @default(true)
  created_at                                    DateTime        @default(now()) @db.Timestamp(0)
  updated_at                                    DateTime?       @db.Timestamp(0)
  deleted_at                                    DateTime?       @db.Timestamp(0)
  appointments_appointments_created_byTousers   appointments[]  @relation("appointments_created_byTousers")
  appointments_appointments_cancelled_byTousers appointments[]  @relation("appointments_cancelled_byTousers")
  audit_logs                                    audit_logs[]
  blocked_slots                                 blocked_slots[]
  doctors                                       doctors[]
  patients                                      patients[]
  roles                                         roles           @relation(fields: [role_id], references: [id], onUpdate: Restrict, map: "users_ibfk_1")

  @@index([role_id], map: "role_id")
}
